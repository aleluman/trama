{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "import", "react", "jsx-a11y", "react-perf"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["node_modules/**", "dist/**", ".artifacts/**"],
  "overrides": [
    {
      "files": ["docs/site/**/*.tsx"],
      "rules": {
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "react-perf/jsx-no-jsx-as-prop": "off"
      }
    },
    {
      "files": ["docs/site/App.tsx", "docs/site/pages/**/*.tsx"],
      "rules": {
        "max-lines-per-function": "off",
        "import/max-dependencies": "off",
        "react/no-unescaped-entities": "off"
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "react-perf"],
      "rules": {
        "typescript/no-explicit-any": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/strict-boolean-expressions": "error",
        "typescript/switch-exhaustiveness-check": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": "allow-with-description",
            "ts-ignore": true,
            "ts-nocheck": true,
            "minimumDescriptionLength": 10
          }
        ],
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error"
      }
    },
    {
      "files": ["scripts/**/*.mjs", "tests/**/*.mjs", "vite.config.mjs"],
      "env": {
        "node": true,
        "browser": false
      }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  }
}
